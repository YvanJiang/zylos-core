{
  "name": "zylos",
  "version": "0.6.0",
  "type": "module",
  "description": "Autonomous AI Agent Infrastructure",
  "main": "cli/zylos.js",
  "bin": {
    "zylos": "./cli/launcher.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "pretest": "node scripts/install-skill-deps.js",
    "test": "npm run test:jest && npm run test:node",
    "test:jest": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:node": "node scripts/run-node-tests.js",
    "test:contracts:five-repo": "node scripts/verify-five-repo-contracts.js",
    "test:release:retired-runtime": "node --experimental-vm-modules node_modules/.bin/jest --runInBand test/five-repo-retired-runtime-gate.test.js test/runtime-normal-path-static.test.js && node scripts/verify-five-repo-retired-runtime.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zylos-ai/zylos-core.git"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "autonomous"
  ],
  "author": "Zylos AI",
  "license": "MIT",
  "engines": {
    "node": ">=20.20.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.215",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.1",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.3.0"
  }
}
