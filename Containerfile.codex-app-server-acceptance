FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.144.5
ARG CANDIDATE_SHA

LABEL org.opencontainers.image.title="Zylos Global43 Codex app-server acceptance"
LABEL org.opencontainers.image.source="https://github.com/zylos-ai/zylos-core"
LABEL org.opencontainers.image.revision="${CANDIDATE_SHA}"
LABEL org.opencontainers.image.codex.version="${CODEX_VERSION}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      build-essential \
      bubblewrap \
      ca-certificates \
      python3 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
    && test "$(codex --version)" = "codex-cli ${CODEX_VERSION}"

WORKDIR /opt/zylos
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY scripts/install-skill-deps.js ./scripts/install-skill-deps.js
COPY skills ./skills
RUN node scripts/install-skill-deps.js
COPY . ./

ENV CODEX_HOME=/acceptance/codex-home
ENV HOME=/acceptance/home
ENV TERM=dumb
RUN mkdir -p "${CODEX_HOME}" "${HOME}"

CMD ["codex", "app-server", "--stdio"]
