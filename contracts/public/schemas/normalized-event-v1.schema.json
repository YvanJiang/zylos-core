{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zylos.ai/public/v1/normalized-event.schema.json",
  "title": "Zylos provider-neutral normalized event v1",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "event_id",
    "trace_id",
    "conversation_id",
    "turn_id",
    "lineage_id",
    "event_sequence",
    "turn_version",
    "attempt_id",
    "attempt_no",
    "lease_epoch",
    "kind",
    "phase",
    "occurred_at",
    "persisted_at",
    "provider",
    "provider_native_id",
    "payload",
    "causation_event_id",
    "error"
  ],
  "properties": {
    "contract": { "const": "zylos.normalized-event" },
    "contract_version": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "event_id": { "$ref": "#/$defs/opaque_id" },
    "trace_id": { "$ref": "#/$defs/opaque_id" },
    "conversation_id": { "$ref": "#/$defs/opaque_id" },
    "turn_id": { "$ref": "#/$defs/opaque_id" },
    "lineage_id": { "$ref": "#/$defs/nullable_id" },
    "event_sequence": { "type": "integer", "minimum": 1 },
    "turn_version": { "type": "integer", "minimum": 1 },
    "attempt_id": { "$ref": "#/$defs/nullable_id" },
    "attempt_no": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "lease_epoch": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "phase": { "enum": ["received", "queued", "starting", "running", "waiting_user", "redirecting", "recovering", "retrying", "completed", "stopped", "cancelled", "interrupted", "failed", "timed_out"] },
    "occurred_at": { "$ref": "#/$defs/rfc3339" },
    "persisted_at": { "$ref": "#/$defs/rfc3339" },
    "provider": { "enum": ["claude", "codex", null] },
    "provider_native_id": { "$ref": "#/$defs/nullable_id" },
    "payload": { "type": "object", "additionalProperties": true },
    "causation_event_id": { "$ref": "#/$defs/nullable_id" },
    "error": { "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "attempt_id": { "type": "null" },
            "attempt_no": { "type": "null" },
            "provider": { "type": "null" },
            "provider_native_id": { "type": "null" }
          }
        },
        {
          "properties": {
            "attempt_id": { "$ref": "#/$defs/opaque_id" },
            "attempt_no": { "type": "integer", "minimum": 1 },
            "lease_epoch": { "type": "integer", "minimum": 1 },
            "provider": { "enum": ["claude", "codex"] }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["text_delta", "text_snapshot", "tool_started", "tool_progress", "tool_finished", "interaction_requested"]
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "attempt_id": { "$ref": "#/$defs/opaque_id" },
          "attempt_no": { "type": "integer", "minimum": 1 },
          "lease_epoch": { "type": "integer", "minimum": 1 },
          "provider": { "enum": ["claude", "codex"] }
        }
      }
    }
  ],
  "additionalProperties": true,
  "x-zylos-known-event-kinds": [
    "turn_state_changed",
    "text_delta",
    "text_snapshot",
    "tool_started",
    "tool_progress",
    "tool_finished",
    "interaction_requested",
    "interaction_answer_committed",
    "interaction_answer_handoff_started",
    "interaction_answered",
    "interaction_answer_delivery_unknown",
    "interaction_rejected",
    "interaction_expired",
    "interaction_cancelled",
    "retry_scheduled",
    "retry_attempt_started",
    "retry_exhausted",
    "recovery_started",
    "recovery_waiting_decision",
    "recovery_finished",
    "permission_changed",
    "permission_rejected",
    "permission_expired",
    "delivery_degraded"
  ],
  "x-zylos-stream-admission": {
    "event_sequence": "continuous_from_1",
    "turn_version": "strictly_increasing",
    "attempt_fence": ["attempt_id", "attempt_no", "lease_epoch"],
    "unknown_kind": "explicit_noncritical_progress_allowlist_only",
    "terminal": "reject_all_late_events"
  },
  "$defs": {
    "opaque_id": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "nullable_id": { "oneOf": [{ "$ref": "#/$defs/opaque_id" }, { "type": "null" }] },
    "rfc3339": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "error": {
      "type": "object",
      "required": ["code", "category", "retryable", "side_effect_status", "user_message", "occurred_at"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "category": { "enum": ["validation", "authentication", "authorization", "conflict", "capacity", "provider", "channel", "storage", "internal"] },
        "retryable": { "type": "boolean" },
        "side_effect_status": { "enum": ["none", "known", "unknown"] },
        "user_message": { "type": "string", "minLength": 1 },
        "detail_ref": { "$ref": "#/$defs/opaque_id" },
        "occurred_at": { "$ref": "#/$defs/rfc3339" }
      },
      "additionalProperties": true
    }
  }
}
